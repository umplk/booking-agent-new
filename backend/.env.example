# ===== 自习室预约系统配置 =====

# 数据库连接字符串
# 默认使用 SQLite（本地开发，无需安装任何数据库服务）
DATABASE_URL=sqlite:///./study_room.db

# 如需切换到 MySQL，只需修改下面这一行连接字符串即可（取消注释并替换为你的 MySQL 信息）：
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/study_room_db

# JWT 配置
# 密钥请用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成，勿使用示例值
JWT_SECRET_KEY=replace-with-a-random-secret-generated-by-secrets-token-urlsafe
JWT_ALGORITHM=HS256
# access 短有效期，靠 refresh 静默续期（单位：分钟）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# refresh 有效期（单位：天），一次性使用，换新后旧令牌立即作废
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=booking-platform
JWT_AUDIENCE=booking-web

# 令牌撤销列表（refresh 轮换 / 登出 / 改密）。为空或连接失败时自动降级为进程内存储
REDIS_URL=redis://localhost:6379/0

# 商家自助注册邀请码；留空则关闭商家自助注册（只能由管理员创建）
MERCHANT_INVITE_CODE=replace-with-your-own-merchant-invite-code

# CORS 配置（允许的来源，逗号分隔；* 表示允许所有）
CORS_ORIGINS=*

# 默认管理员账号
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# DeepSeek（AI 智能体）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_MODEL=deepseek-chat