# ===== 自习室预约系统配置 =====

# 数据库连接字符串
# 默认使用 SQLite（本地开发，无需安装任何数据库服务）
DATABASE_URL=sqlite:///./study_room.db

# 如需切换到 MySQL，只需修改下面这一行连接字符串即可（取消注释并替换为你的 MySQL 信息）：
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/study_room_db

# JWT 配置
JWT_SECRET_KEY=please-change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 配置（允许的来源，逗号分隔；* 表示允许所有）
CORS_ORIGINS=*

# 默认管理员账号
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# DeepSeek（AI 智能体）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_MODEL=deepseek-chat
