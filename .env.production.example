# ===== 生产环境配置 =====
# 复制为 .env.production 后逐项填写；该文件包含密钥，绝不能提交到仓库

# --- MySQL（docker compose 会把这些变量传给 mysql 容器）---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=booking
MYSQL_USER=booking
MYSQL_PASSWORD=change-me-strong-password

# 后端连接串：主机名必须是 compose 服务名 mysql；密码含 @ # / 等字符时要 URL 编码（@ 写成 %40）
DATABASE_URL=mysql+pymysql://booking:change-me-strong-password@mysql:3306/booking?charset=utf8mb4

# --- Redis：仅容器内网访问，不对外暴露端口 ---
REDIS_URL=redis://redis:6379/0

# --- JWT：必须换成强随机值，否则服务拒绝启动 ---
# 生成命令：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-random-48-bytes-generated-by-secrets
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=booking-platform
JWT_AUDIENCE=booking-web

# --- 登录限流：账号 5 次/15 分钟，IP 20 次/15 分钟 ---
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX_FAILURES=20
LOGIN_IP_LOCK_MINUTES=15

# --- CORS：同源部署已不需要跨域；填自己的域名，多个用英文逗号分隔 ---
CORS_ORIGINS=https://your-domain.com

# --- 默认账号：首次上线后立刻登录修改密码 ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-admin-password
DEFAULT_MERCHANT_USERNAME=merchant
DEFAULT_MERCHANT_PASSWORD=change-me-merchant-password

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_MODEL=deepseek-chat

# --- LLM 调用保护 ---
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=5
LLM_QUEUE_WAIT_SECONDS=10
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60